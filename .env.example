# Copy this file to ".env" and fill in the key(s) you have.
# ".env" is ignored by git, so your keys never get uploaded.
# You only need ONE of these. Habitude works with any of them.

# Google Gemini - free tier, no credit card: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Groq - free tier, no credit card, very fast: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter - some free models (":free"), ~50 requests/day: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenCode Go - paid subscription ($10/month) for open models: https://opencode.ai/auth
# Usage and remaining quota are shown only in that console.
OPENCODE_API_KEY=
OPENCODE_GO_MODEL=deepseek-v4.1-flash

# Local models via Ollama - free, no key needed, runs on your own computer.
OLLAMA_HOST=http://localhost:11434

# Paid providers (optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# browser-use sends anonymous usage data by default; this turns it off.
ANONYMIZED_TELEMETRY=false
